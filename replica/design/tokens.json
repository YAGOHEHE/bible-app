   },
   "spanish": {
    "default": "Literata",
    "fallbacks": [
     "New York (.serif)",
     "Iowan Old Style",
     "Georgia"
    ],
    "note": "Igual que latín; incluir cursiva real para KJV/RV."
   },
   "cascade": "Se define la fuente Latin primero y se añade CJK como cascade list (CTFontDescriptor cascade) para que los glifos CJK caigan en Songti SC/PingFang SC sin cambiar el ritmo vertical. Un run por idioma de versión (lang tag zh-Hans / es / en)."
  },
  "mono": "SF Mono, Menlo"
